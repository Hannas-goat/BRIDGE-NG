# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*
expo.log

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folder — /android is intentionally committed (see android/.gitignore for its
# own build-artifact exclusions) since EAS's remote prebuild resolves an incompatible Gradle
# version for this SDK; /ios stays excluded since we haven't built for it yet.
/ios
